[Unit]
Description=Bombardeer Auto-Turret Vision Service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=ben
WorkingDirectory=/home/ben/bombardeer
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/gunicorn --workers 1 --threads 16 --graceful-timeout 10 --bind [::]:5000 --access-logfile - bombardeer:app
TimeoutStartSec=30
TimeoutStopSec=15
WatchdogSec=15
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target