[Unit]
Description=Bombardeer Auto-Turret Vision Service
After=network.target

[Service]
Type=simple
User=ben
WorkingDirectory=/home/ben/Bombardeer
ExecStart=/usr/bin/python3 /home/ben/Bombardeer/turret_stream.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
