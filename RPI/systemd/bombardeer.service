[Unit]
Description=Bombardeer Auto-Turret Vision Service
After=network.target

[Service]
Type=simple
User=ben
WorkingDirectory=/home/ben/bombardeer
ExecStart=/usr/bin/python3 /home/ben/bombardeer/bombardeer.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
